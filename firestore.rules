rules_version = '2';

// Principes §7 :
//  - users/{uid}/** : propriétaire uniquement
//  - users/{uid}/private/** : aucun accès client (Admin SDK only)
//  - products / rankings / feeds / creators / shops / sounds / waves :
//    lecture authentifiée, écriture serveur uniquement
//  - affiliate* : aucune écriture client, tout passe par des Callables
//  - plan sur le doc user : jamais modifiable par le client
//  - App Check requis partout
//
// Tests de règles obligatoires avec @firebase/rules-unit-testing — Phase 1.

// App Check n'est pas exprimable dans les rules elles-mêmes : l'enforcement
// se configure au niveau du projet (Firebase Console > App Check > Firestore).

function isSignedIn() {
  return request.auth != null;
}

function isOwner(uid) {
  return isSignedIn() && request.auth.uid == uid;
}

function isAdmin() {
  return isSignedIn() &&
    exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
    get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin";
}

// Le rôle n'est jamais modifiable par le client — sinon n'importe qui peut
// se déclarer admin. Seule exception : le bootstrap ponctuel ci-dessous,
// à retirer dès que le premier admin est promu (voir tâche associée).
function roleUnchanged() {
  return request.resource.data.role == resource.data.role;
}

// Plan payant en cours de validité. C'est la seule capacité réellement
// appliquée côté serveur : tout le reste du paywall est du rendu client,
// donc contournable, et n'a jamais prétendu au contraire (voir
// PaywallGate.tsx). L'historique des relevés, lui, ne quitte pas la base
// sans un abonnement actif — c'est l'actif qui a le plus de valeur et le
// plus long à reconstituer.
function paidPlan() {
  return isSignedIn() &&
    exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
    get(/databases/(default)/documents/users/$(request.auth.uid)).data.plan.slug in ["creator", "pro"] &&
    get(/databases/(default)/documents/users/$(request.auth.uid)).data.plan.status in ["active", "trialing"];
}

// BOOTSTRAP TEMPORAIRE — à supprimer après la première promotion admin.
function isBootstrapAdminEmail() {
  return request.auth.token.email == "contact.conforva@gmail.com";
}

// Transition radar → essai Pro via un code d'invitation valide (voir
// inviteCodes/{code} et isValidCodeRedemption()). Ne s'applique qu'une
// fois : appliedInviteCode doit passer de null à une chaîne.
function isValidTrialGrant() {
  let newPlan = request.resource.data.plan;
  return resource != null && resource.data.appliedInviteCode == null &&
    request.resource.data.appliedInviteCode is string &&
    newPlan.slug == "pro" && newPlan.status == "active" &&
    newPlan.stripeCustomerId == null && newPlan.currentPeriodEnd is string;
}

// Un update de users/{uid} ne peut jamais toucher au champ `plan` — celui-ci
// n'est écrit que par les webhooks Stripe via Admin SDK.
function planUnchanged() {
  return request.resource.data.plan == resource.data.plan;
}

// Le code de parrainage capturé à l'inscription (§5.3) ne peut plus changer
// une fois écrit — sinon on pourrait réattribuer un compte après coup.
function referredByCodeUnchanged() {
  return request.resource.data.referredByCode == resource.data.referredByCode;
}

// À la création du compte (onboarding), le plan doit être le plan gratuit
// par défaut — sinon un client pourrait se créer directement en "pro".
function defaultPlanOnCreate() {
  let plan = request.resource.data.plan;
  return plan.slug == "radar" && plan.status == "active" &&
    plan.currentPeriodEnd == null && plan.stripeCustomerId == null;
}

function defaultStatsOnCreate() {
  let stats = request.resource.data.stats;
  return stats.briefsGenerated == 0 && stats.videosPosted == 0 &&
    stats.estimatedEarningsCents == 0;
}

// Rédemption d'un code : seul usedCount peut bouger (+1 exactement), tout
// le reste du document inviteCodes doit rester identique — empêche un
// client de se fabriquer un code illimité ou de le réactiver lui-même.
function isValidCodeRedemption() {
  return resource != null &&
    request.resource.data.usedCount == resource.data.usedCount + 1 &&
    resource.data.active == true &&
    resource.data.usedCount < resource.data.maxUses &&
    request.resource.data.code == resource.data.code &&
    request.resource.data.trialDays == resource.data.trialDays &&
    request.resource.data.maxUses == resource.data.maxUses &&
    request.resource.data.active == resource.data.active &&
    request.resource.data.createdAt == resource.data.createdAt &&
    request.resource.data.createdBy == resource.data.createdBy;
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && defaultPlanOnCreate() && defaultStatsOnCreate();
      allow update: if isOwner(uid) && referredByCodeUnchanged() &&
        (planUnchanged() || isValidTrialGrant()) &&
        (roleUnchanged() ||
          (isBootstrapAdminEmail() && request.resource.data.role == "admin"));
      // Pas de Cloud Functions (plan Spark) — la suppression RGPD (art. 17)
      // se fait depuis le client : il peut donc supprimer son propre doc.
      allow delete: if isOwner(uid);

      match /private/{document=**} {
        allow read, write: if false;
      }

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid) && subcollection in
          ["watchlist", "portfolio", "briefs", "notifications"];
      }

      // Sous-collection à document unique (§5) — {docId=**} pour couvrir le
      // get() sur le document, pas seulement le list() sur la collection.
      // delete autorisé pour la suppression RGPD du compte ; create/update
      // restent serveur uniquement (Phase 6, quand les Callables existeront).
      match /affiliate/{docId=**} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if false;
      }
    }

    // Lecture réservée aux comptes connectés. La règle avait été ouverte à
    // tous (`if true`) pour un rendu statique au build ; les pages de
    // classement sont depuis passées en chargement client derrière
    // <RequireAuth>, ce qui a rendu cette ouverture inutile — mais elle
    // n'avait jamais été refermée. Elle laissait n'importe qui vider tout
    // le catalogue avec la configuration Firebase publique, c'est-à-dire
    // récupérer gratuitement le produit lui-même.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /videos/{videoId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      // Un relevé par produit par jour — forme d'entrée de computeVerdict
      // (packages/core), saisis à la main depuis /admin/produits.
      //
      // C'est la capacité « productHistory » du catalogue d'offres, et la
      // seule à être réellement appliquée ici plutôt qu'à l'écran : un
      // compte gratuit ne peut pas lire l'historique, même en appelant
      // Firestore directement. L'admin garde l'accès, sans quoi le
      // pipeline client (qui recalcule les verdicts) ne pourrait plus
      // tourner.
      match /snapshots/{capturedDate} {
        allow read: if paidPlan() || isAdmin();
        allow write: if isAdmin();
      }
    }

    match /creators/{creatorId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /shops/{shopId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sounds/{soundId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Le classement complet et les verdicts sont ce que le plan gratuit
    // offre : lecture ouverte à tout compte connecté, sans distinction de
    // plan. Ce qui se vend est le détail des gains et l'historique.
    match /rankings/{rankingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /feeds/{feedId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /waves/{waveId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Cache 7 jours des briefs Créa DNA (Lot 6), clé (produit × niche ×
    // fourchette d'abonnés) — jamais par utilisateur, sinon zéro
    // réutilisation. Écriture serveur uniquement (Cloud Run creative-dna).
    match /briefCache/{cacheId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Perk "code d'invitation → essai Pro", pas le programme d'affiliation
    // §5 (Phase 6). Lecture ouverte à tout signé (nécessaire pour valider
    // un code avant rédemption) ; create/désactivation réservés à l'admin ;
    // la rédemption elle-même passe par isValidCodeRedemption().
    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && isValidCodeRedemption());
      allow delete: if isAdmin();
    }

    match /affiliateClicks/{clickId} {
      allow read, write: if false;
    }

    match /affiliateReferrals/{referralId} {
      allow read: if isSignedIn() &&
        (resource.data.referrerUid == request.auth.uid ||
         resource.data.referredUid == request.auth.uid);
      allow write: if false;
    }

    match /affiliatePayouts/{payoutId} {
      allow read: if isSignedIn() && resource.data.affiliateUid == request.auth.uid;
      allow write: if false;
    }

    // Archive des classements — fenêtre glissante de 30 jours, un seul
    // document par marché/période. C'est l'actif que le plan Pro vend :
    // il ne se reconstitue pas rétroactivement, donc il doit être protégé
    // côté serveur et pas seulement masqué à l'écran.
    //
    // `paidPlan()` et non un contrôle « pro » : les alertes de Creator se
    // calculent à partir des mêmes mouvements de rang. Ce que Pro débloque,
    // ce sont les *outils* (parcourir les journées passées, la trajectoire,
    // la comparaison, l'export), pas l'octet brut.
    //
    // Écriture réservée à `isAdmin()`, comme `rankings/*` : le pipeline qui
    // la remplit tourne dans le **navigateur** de l'administrateur (décision
    // #9, plan Spark), pas dans un job serveur. Un `write: if false` la
    // rendrait donc impossible à écrire — c'est ce que la première version
    // faisait, et le pipeline entier échouait.
    match /rankingArchive/{docId} {
      allow read: if paidPlan() || isAdmin();
      allow write: if isAdmin();
    }

    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Règles Compliance Guard (Lot 8) — un chemin plus précis que
    // config/{docId} ci-dessus l'emporte pour ce document précis : seul
    // un admin peut l'écrire, éditable sans redéploiement.
    match /config/complianceRules {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
