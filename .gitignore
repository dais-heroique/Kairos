node_modules/
.turbo/
dist/
# Uniquement la sortie de build des packages (tsc), jamais un dossier
# source nommé "lib" ailleurs (ex. apps/web/src/lib/) — un simple "lib/"
# matchait par erreur ce dernier et l'excluait entièrement du repo.
packages/*/lib/
.next/
out/
.env
.env.local
.env.local.bak
.env.*.local
.emulator-data/
# Cache local du CLI Firebase généré à chaque déploiement (build artifacts) —
# jamais versionné, similaire à .next/ ou node_modules/.
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log
*.tsbuildinfo
.DS_Store
# Le volume est en ExFAT : macOS génère un fichier ._<nom> (AppleDouble) à
# côté de chaque fichier écrit. Inoffensif mais bruyant — voir aussi
# vitest.config.ts (exclude) dans packages/shared et packages/core.
._*

# État local d'un outil d'orchestration d'agents, pas du code du projet.
.claude-flow/
.vscode/*
!.vscode/extensions.json

# Clés de compte de service Firebase / Google — ne doivent JAMAIS être
# committées. Elles donnent un accès complet à la base et contournent
# toutes les règles de sécurité. Elles vivent hors du dépôt, et dans les
# secrets Cloudflare pour le Worker.
*firebase-adminsdk*.json
*serviceaccount*.json
*service-account*.json
service-account*.json
