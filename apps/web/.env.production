# Config publique du projet Firebase "kairos-on" — ces valeurs ne sont pas
# des secrets (voir décision Phase 0), safe à committer. Utilisée par
# `next build` lors du déploiement Firebase Hosting.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBJB1dUWOyHeUcwdQZKCbD9yrlq96Qdokw
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kairos-on.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kairos-on
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kairos-on.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=394406245286
NEXT_PUBLIC_FIREBASE_APP_ID=1:394406245286:web:1f44514b646f63ae7a9567
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Encaissement Stripe — publics par nature (ils apparaissent dans l'URL de
# paiement). La clé secrète, elle, ne vit que dans les secrets du Worker.
NEXT_PUBLIC_STRIPE_WORKER_URL=https://kairos-stripe.t-dufour1703.workers.dev
# Portail client « sans code » de Stripe. Sert de secours : le bouton passe
# d'abord par le Worker, qui ouvre le portail sur le bon client sans rien
# demander. Si cet appel échoue, ce lien reste utilisable — le client y
# saisit son email et reçoit un accès. Résilier ne doit dépendre d'aucune
# de nos briques (obligation légale, art. L. 215-1).
NEXT_PUBLIC_STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/5kQ00cbcT6T8cjI79G8AE00
NEXT_PUBLIC_STRIPE_PRICE_CREATOR_MONTHLY=price_1U2Zjw4Do0A9o9JDl0l0oZkU
NEXT_PUBLIC_STRIPE_PRICE_CREATOR_YEARLY=price_1U2ZmQ4Do0A9o9JDMmG04oUW
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=
