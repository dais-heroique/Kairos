# Copier en .env.local — valeurs du projet Firebase "demo-kairos" pour le
# dev local avec émulateurs. Voir §8 du brief pour la liste complète
# (fonctions, collector) et le README racine pour la procédure.

NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-kairos.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-kairos
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-kairos.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=true

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Encaissement Stripe — publics par nature (ils apparaissent dans l'URL de
# paiement). La clé secrète, elle, ne vit que dans les secrets du Worker.
NEXT_PUBLIC_STRIPE_WORKER_URL=
NEXT_PUBLIC_STRIPE_PRICE_CREATOR_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_CREATOR_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=
