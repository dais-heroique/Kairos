{
  "name": "@kairos/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "apify:scrape": "tsx src/apify-scrape.ts",
    "apify:scrape:dry": "tsx src/apify-scrape.ts --dry-run",
    "apify:intelligent": "tsx src/apify-intelligent-scrape.ts",
    "apify:intelligent:dry": "tsx src/apify-intelligent-scrape.ts --dry-run",
    "apify:intelligent:verbose": "tsx src/apify-intelligent-scrape.ts --verbose",
    "recover:apify": "tsx src/recover-apify-data.ts"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.0",
    "@kairos/core": "workspace:*",
    "@kairos/shared": "workspace:*",
    "apify-client": "^2.24.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
