rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Visuels générés (kit de partage affiliation, exports) : lecture propriétaire,
    // écriture serveur uniquement (Cloud Functions / Cloud Run via Admin SDK).
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
