# Voir §8 du brief produit. Ne jamais commit de vraies valeurs — ce fichier
# ne contient que les noms de variables. Copier vers .env / .env.local selon
# l'app (apps/web, apps/collector, apps/jobs, functions).

# Firebase / GCP
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
BIGQUERY_DATASET=kairos

# IA
ANTHROPIC_API_KEY=
VERTEX_LOCATION=europe-west1
AI_DAILY_BUDGET_EUR=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# TikTok Shop API officielle (apps/jobs — exécution locale, jamais côté
# navigateur : les appels sont signés en HMAC-SHA256 avec TIKTOK_APP_SECRET,
# qui ne doit jamais partir dans un bundle client).
# app_key / app_secret : Partner Center > ton app > Credentials.
# shop_cipher + access_token : obtenus après autorisation de la boutique.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_SHOP_CIPHER=
TIKTOK_SHOP_ID=
# Base régionale — l'API TikTok Shop est régionalisée ; vérifier celle
# indiquée dans ton Partner Center pour le marché FR.
TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com

# Collector (Cloud Run uniquement)
PROXY_LIST_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
COLLECTOR_SERVICE_TOKEN=
# Fournisseur tiers de données produit (contrat REST documenté, à
# privilégier sur le scraping — voir apps/collector/src/sources/thirdparty.ts)
THIRDPARTY_PROVIDER_BASE_URL=
THIRDPARTY_PROVIDER_API_KEY=
# Apify TikTok Shop Search Pro Actor
# Token: https://console.apify.com/account/integrations/api
# Actor ID: Hr1hjEAGdYMr1RbUj (TikTok Shop Search Pro)
APIFY_API_TOKEN=
APIFY_ACTOR_ID=Hr1hjEAGdYMr1RbUj
APIFY_MAX_PAGES=3
APIFY_MAX_RESULTS=200

# Sécurité
FINGERPRINT_SALT=
KMS_KEY_NAME=

# Observabilité
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Encaissement Stripe — publics par nature (ils apparaissent dans l'URL de
# paiement). La clé secrète, elle, ne vit que dans les secrets du Worker.
NEXT_PUBLIC_STRIPE_WORKER_URL=
NEXT_PUBLIC_STRIPE_PRICE_CREATOR_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_CREATOR_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=
