{
  "name": "kairos",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:rules": "firebase emulators:exec --only firestore \"pnpm --filter @kairos/firestore-rules-tests test\"",
    "test:jobs-integration": "firebase emulators:exec --only firestore \"pnpm --filter @kairos/jobs test\"",
    "test:web-integration": "firebase emulators:exec --only firestore,auth \"pnpm --filter @kairos/web test\"",
    "emulators": "firebase emulators:start --import=./.emulator-data --export-on-exit",
    "deploy:prod": "./scripts/deploy.sh",
    "deploy:check": "./scripts/deploy.sh --dry-run"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  }
}
